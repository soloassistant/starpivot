  "dataset": "real_stars",
  "description": "真实恒星。每一行都是 ESA Hipparcos 主表（VizieR I/239/hip_main）里的观测值：ICRS 赤经赤纬、V 波段视星等、三角视差、光谱型。不是类型代表值，是真实个体。",
  "source": {
    "name": "ESA Hipparcos Main Catalogue",
    "table": "I/239/hip_main (VizieR / CDS)",
    "service": "VizieR TAP sync (https://tapvizier.cds.unistra.fr/TAPVizieR/tap/sync)",
    "retrieved": "2026-09-26",
    "query": "select top 60 HIP,\"_RA.icrs\",\"_DE.icrs\",Vmag,Plx,SpType from \"I/239/hip_main\" where Vmag<2.5",
    "note": "取的是 Vmag<2.5 的亮星。列名踩过一次坑：I/239/hip_main 里位置列叫 _RA.icrs / _DE.icrs，不叫 RAdeg / DEdeg（用后两个名会报 Unknown column）。"
  },
  "units": {
    "_RA.icrs": "度（ICRS，J2000 历元）",
    "_DE.icrs": "度（ICRS，J2000 历元）",
    "Vmag": "视星等（V 波段）",
    "Plx": "三角视差（毫角秒 mas）",
    "SpType": "MK 光谱型字符串（原始观测归类，含光度级与备注）"
  },
  "identifier_note": "本文件用 HIP 编号做标识。**刻意不做「HIP → 中文星名」的映射**：那张对照表不在本文件的来源里，凭印象写会引入无法追溯的错误。星名要做就得从权威表另取一次，并记录出处。",
  "derived_chain": {
    "warning": "下面这些是**推导值**，不是观测值。页面上必须与观测值区分标注。",
    "distance_pc": "d = 1000 / Plx        （视差单位 mas）",
    "absolute_mag_V": "M_V = Vmag - 5*log10(d) + 5",
    "t_eff_from_sptype": "T_eff 由光谱型查标定表（标定表，非观测）—— 待接入，需引用具体出处",
    "bolometric_correction": "BC 由 T_eff 查表（标定表，非观测）—— 待接入，需引用具体出处",
    "luminosity": "M_bol = M_V + BC;  L = 10^((M_bol_sun - M_bol)/2.5)"
  },
