  "field_semantics": {
    "pl_bmassprov": {
      "meaning": "质量出处/方法。由官方 TAP_SCHEMA 描述为 'Planet Mass or Mass*sin(i) Provenance'。",
      "retrieved_vocabulary": "对全表 pscomppars 做 group by 实测得到的完整取值域（非凭记忆）",
      "full_table_vocabulary": {
        "M-R relationship": 2970,
        "Mass": 2462,
        "Msini": 925,
        "Msin(i)/sin(i)": 15
      },
      "how_to_use": "Msini 表示该值为 m*sin(i)，是视向速度给出的质量【下限】；Mass 表示【绝对/实测质量】，不是下限；M-R relationship 表示质量由质径关系推得，不是实测；Msin(i)/sin(i) 表示已假定/已知 sin(i) 后由 m*sin(i) 反推的绝对质量。",
      "note": "取值域里【没有】'TTV' 这个字面值。Archive 不用 'TTV' 标注凌星计时质量，而用 'Mass'。因此不能凭 pl_bmassprov 直接断言'某颗来自 TTV'。"
    },
    "pl_bmassjlim": {
      "official_description": "TAP_SCHEMA 原文: 'Planet Mass or Mass*sin(i) [Jupiter Mass] Limit Flag'（未给出取值枚举）",
      "semantics": "未验证",
      "observed_for_our_19": "19 颗全部为 0",
      "warning": "全表实测显示 pl_bmassjlim 不能当作'是否下限'的判据：有 891 颗 pl_bmassprov='Msini'（真·下限）其 lim 却是 0；反过来 221 颗 prov='Mass'（绝对质量）其 lim 是 1。判断是否下限请一律用 pl_bmassprov。"
    },
    "pl_bmassjsymerr": {
      "meaning": "误差是否对称的标志位；本文件按实测归纳：1 = 对称（|err1| == |err2|），0 = 非对称",
      "verification": "在本批 19 颗样本上逐一验证成立；未在官方文档中核实其定义，故记为'实测归纳'而非'官方定义'"
    }
